{
  "version": "v1",
  "hooks": [
    {
      "name": "저장 시 GitHub 자동 업로드",
      "trigger": "PostFileSave",
      "description": "소스 파일을 저장하면 자동으로 커밋해서 GitHub(kingkong-inventory)에 업로드합니다.",
      "matcher": "\\.(py|html|js|css|json|md|txt|sh|yaml|yml|bat)$",
      "action": {
        "type": "command",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .kiro/scripts/auto-push.ps1 -Reason save",
        "timeout": 120
      }
    }
  ]
}
